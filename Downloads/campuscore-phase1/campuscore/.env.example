# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — never exposed to the browser. Used solely by trusted
# server-side jobs (e.g. bulk import, Phase 3) that must bypass RLS
# intentionally and explicitly. Do NOT use this in route handlers that
# serve normal user requests — those should use the user's own session
# so RLS applies normally.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by `npm run db:types` to generate TypeScript types from your schema.
SUPABASE_PROJECT_ID=your-project-ref
